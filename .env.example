# Liliana — configuration.
# Copiez ce fichier en `.env` puis ajustez. Toutes les valeurs sont optionnelles :
# les défauts du code s'appliquent pour ce qui n'est pas renseigné.

APP_NAME=Liliana
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------- LLM
# Laissez LLM_MODEL vide : Liliana choisit toute seule, parmi les modèles
# installés dans Ollama, celui qui convient le mieux à votre machine (elle
# écarte les modèles d'embedding ou de code, préfère les variantes `instruct`,
# et évite un modèle trop gros pour votre mémoire). Le choix est journalisé et
# affiché dans l'interface. Renseignez ce champ seulement pour l'imposer.
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
LLM_MAX_HISTORY_TURNS=12
# Temps pendant lequel Ollama garde le modele charge entre deux tours. Sans GPU,
# le rechargement coute plusieurs dizaines de secondes : c'est ce qui rend la
# reprise apres une pause si lente. `-1` = ne jamais decharger.
LLM_KEEP_ALIVE=30m

# Modele par langue. Le bon modele depend de la langue travaillee, pas de la
# machine : sur le contrat de sortie de Liliana, un 1.5B corrige l'anglais aussi
# bien qu'un 3B et pres de trois fois plus vite (7,5 s contre 21,5 s par tour),
# mais s'effondre sur les cas et les genres allemands (6/12 contre 11/12).
# Laissez vide pour utiliser LLM_MODEL, ou la selection automatique.
LLM_MODEL_ENGLISH=
LLM_MODEL_GERMAN=
LLM_MODEL_FRENCH=

# ---------------------------------------------------------------------- STT
# tiny | base | small | medium | large-v3  (plus grand = plus précis, plus lent)
STT_PROVIDER=faster-whisper
STT_MODEL=small
STT_DEVICE=auto          # auto | cpu | cuda
STT_COMPUTE_TYPE=auto    # auto | int8 | float16 | float32
STT_BEAM_SIZE=5          # 1 = le plus rapide, 5 = nettement plus sur
                         # (mesure : +0,2 s seulement sur ce modele)

# ---------------------------------------------------------------------- TTS
# `none` désactive la voix : Liliana répond alors en texte seul.
TTS_PROVIDER=piper
TTS_BINARY=piper
TTS_VOICE_ENGLISH=en_US-lessac-medium
TTS_VOICE_GERMAN=de_DE-thorsten-medium
TTS_VOICE_FRENCH=fr_FR-siwis-medium
TTS_LENGTH_SCALE=1.0     # > 1.0 = parle plus lentement

# ------------------------------------------------------------------ pédagogie
DEFAULT_LANGUAGE=english   # english | german
CORRECTION_MODE=normal     # off | minimal | normal | strict

# ---------------------------------------------------------------------- VAD
# Détection de fin de phrase, exécutée dans le navigateur.
VAD_SILENCE_THRESHOLD=1.5    # secondes de silence avant traitement
                             # (0.8 coupait la parole de qui cherche ses mots)
VAD_ENERGY_THRESHOLD=0.015   # sensibilité du micro (baisser si vous parlez bas)
VAD_MIN_SPEECH_DURATION=0.3  # ignore les bruits plus courts

# ----------------------------------------------------------------- mot d'eveil
# En ecoute permanente, Liliana ne repond que si on l'appelle. Whisper transcrit
# tout (c'est bon marche), mais le modele de langue n'est sollicite que sur un
# appel reconnu. Plusieurs noms possibles, separes par des virgules.
WAKE_WORD=Liliana
WAKE_WORD_SIMILARITY=0.8     # 1.0 = exact ; 0.8 tolere « Lilliana », « Liliane »
WAKE_FOLLOW_UP_SECONDS=30    # delai pour enchainer sans redire son nom

# ------------------------------------------------------------------ stockage
DATABASE_PATH=data/liliana.db
MODELS_DIR=models
LOG_DIR=logs
LOG_LEVEL=INFO

# Les enregistrements audio ne sont JAMAIS conservés tant que ceci vaut false.
SAVE_AUDIO=false
